;;; windmove-buffer-tests.el --- Directional move tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'windmove)

(let ((source (expand-file-name "../myInit.org"
                                (file-name-directory load-file-name))))
  (with-temp-buffer
    (insert-file-contents source)
    (search-forward "** windmove")
    (search-forward "#+begin_src emacs-lisp")
    (let ((end (save-excursion (search-forward "#+end_src") (line-beginning-position)))
          form)
      (while (< (point) end)
        (skip-chars-forward " \t\r\n")
        (when (< (point) end)
          (setq form (read (current-buffer)))
          (if (eq (car-safe form) 'use-package)
              (dolist (binding (plist-get (cddr form) :bind))
                (global-set-key (kbd (car binding)) (cdr binding)))
            (eval form t)))))))

(defmacro my/windmove-test-layout (&rest body)
  `(save-window-excursion
     (let ((a (generate-new-buffer " *move-a*"))
           (b (generate-new-buffer " *move-b*"))
           (c (generate-new-buffer " *move-c*"))
           (window-min-height 2)
           (window-min-width 2))
       (unwind-protect
           (progn
             (delete-other-windows)
             (switch-to-buffer a)
             (dolist (buffer (list a b c))
               (with-current-buffer buffer
                 (dotimes (i 200) (insert (format "%03d text\n" i)))))
             ,@body)
         (mapc #'kill-buffer (list a b c))))))

(ert-deftest my/windmove-test-four-directions ()
  (dolist (direction '(left right up down))
    (my/windmove-test-layout
     (let* ((source (selected-window))
            (horizontal (memq direction '(up down)))
            (target (split-window source nil direction)))
       (set-window-buffer target b)
       (set-window-point source 101)
       (set-window-start source 41)
       (set-window-hscroll source 3)
       (set-window-point target 81)
       (set-window-start target 21)
       (let ((overlay (with-current-buffer a (make-overlay 1 5))))
         (overlay-put overlay 'window source)
         (my/windmove-buffer direction)
         (let ((destination (selected-window)))
           (should (= (length (window-list)) 2))
           (should-not (window-live-p source))
           (should (eq (window-buffer destination) a))
           (should (eq (window-buffer target) b))
           (should (= (window-point destination) 101))
           (should (= (window-start destination) 41))
           (should (= (window-hscroll destination) 3))
           (should (= (window-point target) 81))
           (should (= (window-start target) 21))
           (should (eq (overlay-get overlay 'window) destination))
           (should (eq (window-in-direction
                        (if horizontal 'right 'down) destination) target))
           (should (<= (abs (- (window-total-size destination horizontal)
                               (window-total-size target horizontal))) 1))
           (should (buffer-live-p a))
           (should (buffer-live-p b))))))))

(ert-deftest my/windmove-test-missing-neighbor-does-not-wrap ()
  (my/windmove-test-layout
   (let ((windmove-wrap-around t)
         (source (selected-window)))
     (set-window-buffer (split-window-below) b)
     (my/windmove-buffer-up)
     (should (eq (selected-window) source))
     (should (eq (window-buffer source) a))
     (should (= (length (window-list)) 2)))))

(ert-deftest my/windmove-test-missing-horizontal-neighbor-creates-column ()
  (dolist (direction '(left right))
    (my/windmove-test-layout
     (let* ((source (selected-window))
            (remaining (split-window-below))
            (windmove-wrap-around t))
       (set-window-buffer remaining b)
       (set-window-point source 101)
       (set-window-start source 41)
       (my/windmove-buffer direction)
       (let ((destination (selected-window)))
         (should (= (length (window-list)) 2))
         (should-not (window-live-p source))
         (should (eq (window-buffer destination) a))
         (should (eq (window-buffer remaining) b))
         (should (= (window-point destination) 101))
         (should (= (window-start destination) 41))
         (should (eq (window-in-direction
                      (if (eq direction 'left) 'right 'left) destination)
                     remaining))
         (should (= (window-total-height destination)
                    (window-total-height remaining)))
         (should (<= (abs (- (window-total-width destination)
                             (window-total-width remaining))) 1)))))))

(ert-deftest my/windmove-test-new-column-remains-balancable ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (lower (split-window-below))
          (other (split-window source nil 'right)))
     (set-window-buffer lower b)
     (set-window-buffer other c)
     (my/windmove-buffer-left)
     (let ((destination (selected-window)))
       (should (= (length (window-list)) 3))
       (should (= (window-total-height destination)
                  (window-total-height (frame-root-window))))
       (should (eq (window-buffer lower) b))
       (should (eq (window-buffer other) c))
       (balance-windows)
       (let ((sizes (mapcar #'window-total-width (window-list))))
         (should (<= (- (apply #'max sizes) (apply #'min sizes)) 1)))))))

(ert-deftest my/windmove-test-edge-column-balances-three-columns ()
  (dolist (direction '(left right))
    (my/windmove-test-layout
     (let* ((source (selected-window))
            (other (split-window source nil
                                 (if (eq direction 'left) 'right 'left)))
            (remaining (split-window source nil 'below)))
       (set-window-buffer remaining b)
       (set-window-buffer other c)
       (my/windmove-buffer direction)
       (let ((destination (selected-window)))
         (should (eq (window-buffer destination) a))
         (should-not (window-live-p source))
         (should (= (window-total-height destination)
                    (window-total-height (frame-root-window))))
         (balance-windows)
         (let ((sizes (mapcar #'window-total-width (window-list))))
           (should (<= (- (apply #'max sizes) (apply #'min sizes)) 1))))))))

(ert-deftest my/windmove-test-single-window-does-not-change ()
  (my/windmove-test-layout
   (let ((source (selected-window)))
     (dolist (direction '(left right up down))
       (my/windmove-buffer direction)
       (should (eq (selected-window) source))
       (should (= (length (window-list)) 1))))))

(ert-deftest my/windmove-test-new-column-rollback ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (lower (split-window-below))
          (edges (mapcar #'window-edges (window-list))))
     (set-window-buffer lower b)
     (cl-letf (((symbol-function 'my/windmove--balance-group)
                (lambda (&rest _) (user-error "Injected column failure"))))
       (should-error (my/windmove-buffer-right) :type 'user-error))
     (should (equal (mapcar #'window-edges (window-list)) edges))
     (should (eq (selected-window) source))
     (should (eq (window-buffer lower) b)))))

(ert-deftest my/windmove-test-balances-existing-siblings ()
  (dolist (horizontal '(nil t))
    (my/windmove-test-layout
     (let* ((source (selected-window))
            (target (split-window source nil (if horizontal 'below 'right)))
            (sibling (split-window target nil (if horizontal 'right 'below))))
       (set-window-buffer target b)
       (set-window-buffer sibling c)
       (my/windmove-buffer (if horizontal 'down 'right))
       (let ((sizes (mapcar (lambda (w) (window-total-size w horizontal))
                            (window-list))))
         (should (= (length sizes) 3))
         (should (<= (- (apply #'max sizes) (apply #'min sizes)) 1)))))))

(ert-deftest my/windmove-test-keeps-unrelated-column ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (target (split-window-right))
          (unrelated (split-window target nil 'right))
          (width (window-total-width unrelated)))
     (set-window-buffer target b)
     (set-window-buffer unrelated c)
     (my/windmove-buffer-right)
     (should (= (window-total-width unrelated) width))
     (should (eq (window-buffer unrelated) c)))))

(ert-deftest my/windmove-test-keeps-nested-widths ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (target (split-window-right))
          (lower (split-window target nil 'below))
          (lower-right (split-window lower -10 'right))
          (ratio (/ (float (window-total-width lower-right))
                    (window-total-width (window-parent lower-right)))))
     (my/windmove-buffer-right)
     (should (<= (abs (- (window-total-width lower-right)
                         (* ratio (window-total-width
                                   (window-parent lower-right))))) 1)))))

(ert-deftest my/windmove-test-keeps-unrelated-row ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (target (split-window-below))
          (unrelated (split-window target nil 'below))
          (height (window-total-height unrelated)))
     (set-window-buffer target b)
     (set-window-buffer unrelated c)
     (my/windmove-buffer-down)
     (should (= (window-total-height unrelated) height))
     (should (eq (window-buffer unrelated) c)))))

(ert-deftest my/windmove-test-keybindings ()
  (dolist (entry '(("h" . left) ("j" . down) ("k" . up) ("l" . right)))
    (should (eq (key-binding (kbd (concat "C-c w m " (car entry))))
                (intern (format "my/windmove-buffer-%s" (cdr entry)))))
    (should (eq (key-binding (kbd (concat "C-c w s " (car entry))))
                (intern (format "windmove-swap-states-%s" (cdr entry)))))))

(ert-deftest my/windmove-test-rejects-dedicated-target ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (target (split-window-right)))
     (set-window-buffer target b)
     (set-window-dedicated-p target t)
     (should-error (my/windmove-buffer-right) :type 'user-error)
     (should (eq (selected-window) source))
     (should (eq (window-buffer target) b))
     (should (= (length (window-list)) 2)))))

(ert-deftest my/windmove-test-rolls-back-failed-balancing ()
  (my/windmove-test-layout
   (let* ((source (selected-window))
          (target (split-window-right))
          (overlay (with-current-buffer a (make-overlay 1 5)))
          (edges (mapcar #'window-edges (window-list))))
     (set-window-buffer target b)
     (overlay-put overlay 'window source)
     (cl-letf (((symbol-function 'my/windmove--balance-group)
                (lambda (&rest _) (user-error "Injected resize failure"))))
       (should-error (my/windmove-buffer-right) :type 'user-error))
     (should (equal (mapcar #'window-edges (window-list)) edges))
     (should (eq (selected-window) source))
     (should (eq (window-buffer source) a))
     (should (eq (window-buffer target) b))
     (should (eq (overlay-get overlay 'window) source)))))

(ert-deftest my/windmove-test-rolls-back-failed-split ()
  (my/windmove-test-layout
   (let ((source (selected-window))
         (target (split-window-right)))
     (set-window-buffer target b)
     (cl-letf (((symbol-function 'split-window)
                (lambda (&rest _) (user-error "Injected split failure"))))
       (should-error (my/windmove-buffer-right) :type 'user-error))
     (should (eq (selected-window) source))
     (should (eq (window-buffer target) b))
     (should (= (length (window-list)) 2)))))

(ert-deftest my/windmove-test-too-small-target-keeps-layout ()
  (my/windmove-test-layout
   (let* ((source (split-window (selected-window) -3 'below))
          (target (split-window source nil 'right)))
     (set-window-buffer source a)
     (set-window-buffer target b)
     (select-window source)
     (let ((edges (mapcar #'window-edges (window-list))))
       (should-error (my/windmove-buffer-right))
       (should (equal (mapcar #'window-edges (window-list)) edges))
       (should (eq (selected-window) source))
       (should (eq (window-buffer source) a))
       (should (eq (window-buffer target) b))))))


{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Force y/n to English in iTerm2 (Korean mode)",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "com.googlecode.iterm2"
                                        ],
                                        "type": "frontmost_application_if"
                                    },
                                    {
                                        "input_sources": [{ "language": "ko" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "y",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "y" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "com.googlecode.iterm2"
                                        ],
                                        "type": "frontmost_application_if"
                                    },
                                    {
                                        "input_sources": [{ "language": "ko" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "n" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "After Ctrl+z, force next key to English",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "language": "ko" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "z",
                                    "modifiers": {
                                        "mandatory": ["control"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "z",
                                        "modifiers": ["left_control"]
                                    },
                                    { "select_input_source": { "input_source_id": "com.apple.keylayout.ABC" } },
                                    {
                                        "set_variable": {
                                            "name": "tmux_waiting",
                                            "value": 1
                                        }
                                    }
                                ],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "tmux_waiting",
                                                "value": 0
                                            }
                                        },
                                        { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
                                    ],
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "tmux_waiting",
                                                "value": 0
                                            }
                                        },
                                        { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
                                    ]
                                },
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "tmux_waiting",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "any": "key_code" },
                                "to": [
                                    { "key_code": "current_key_code" },
                                    {
                                        "set_variable": {
                                            "name": "tmux_waiting",
                                            "value": 0
                                        }
                                    },
                                    { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": { "is_keyboard": true },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "caps_lock" },
                            "to": [{ "key_code": "left_control" }]
                        },
                        {
                            "from": { "key_code": "left_command" },
                            "to": [{ "key_code": "left_option" }]
                        },
                        {
                            "from": { "key_code": "left_option" },
                            "to": [{ "key_code": "left_command" }]
                        }
                    ]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }

{
  "title": "Tmux Korean Fix with y/n Support",
  "rules": [
    {
      "description": "After Ctrl+z, force next key to English",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "input_source_if",
              "input_sources": [{ "language": "ko" }]
            }
          ],
          "from": {
            "key_code": "z",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "z", "modifiers": ["left_control"] },
            { "select_input_source": { "input_source_id": "com.apple.keylayout.ABC" } },
            { "set_variable": { "name": "tmux_waiting", "value": 1 } }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              { "set_variable": { "name": "tmux_waiting", "value": 0 } },
              { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
            ],
            "to_if_canceled": [
              { "set_variable": { "name": "tmux_waiting", "value": 0 } },
              { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
            ]
          }
        },
        {
          "type": "basic",
          "conditions": [ { "type": "variable_if", "name": "tmux_waiting", "value": 1 } ],
          "from": { "any": "key_code" },
          "to": [
            { "key_code": "current_key_code" },
            { "set_variable": { "name": "tmux_waiting", "value": 0 } },
            { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
          ]
        }
      ]
    },
    {
      "description": "Force y/n to English in iTerm2 (Korean mode)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "com.googlecode.iterm2",
                "com.github.wez.wezterm"
              ]
            },
            { "type": "input_source_if", "input_sources": [{ "language": "ko" }] }
          ],
          "to": [
            { "key_code": "y" },
            { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "com.googlecode.iterm2",
                "com.github.wez.wezterm"
              ]
            },
            { "type": "input_source_if", "input_sources": [{ "language": "ko" }] }
          ],
          "from": { "key_code": "n", "modifiers": { "optional": ["any"] } },
          "to": [
            { "key_code": "n" },
            { "select_input_source": { "input_source_id": "com.apple.inputmethod.Korean.2SetKorean" } }
          ]
        }
      ]
    }
  ]
}
